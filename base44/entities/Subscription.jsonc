{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "premium",
        "professional",
        "family"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "pink",
        "yellow"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "expired",
        "cancelled"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "gray"
      ]
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "annual"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ]
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "started_on": {
      "type": "string"
    },
    "renews_on": {
      "type": "string"
    },
    "auto_renew": {
      "type": "boolean"
    }
  },
  "required": [
    "plan",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}