{
  "name": "TrainerSession",
  "type": "object",
  "properties": {
    "exercise": {
      "type": "string"
    },
    "detected_exercise": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "video"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "reps": {
      "type": "number"
    },
    "hold_seconds": {
      "type": "number"
    },
    "form_score": {
      "type": "number"
    },
    "duration_sec": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "voice_enabled": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "dose": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "exercise",
    "mode"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}