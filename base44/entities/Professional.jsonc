{
  "name": "Professional",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "specialization": {
      "type": "string",
      "enum": [
        "dietitian",
        "trainer"
      ],
      "enumColors": [
        "green",
        "blue"
      ]
    },
    "credentials": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "suspended"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ]
    },
    "rating": {
      "type": "number"
    },
    "client_count": {
      "type": "number"
    },
    "country": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "specialization"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}