{
  "name": "MemberPhone",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "Mobile number as saved, e.g. +94771234567"
    },
    "phone_key": {
      "type": "string",
      "description": "Last 9 digits, used to match the number at sign-in"
    },
    "verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}