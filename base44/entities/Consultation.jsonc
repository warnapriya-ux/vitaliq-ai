{
  "name": "Consultation",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "professional_name": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "scheduled_for": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "gray"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "topic"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}