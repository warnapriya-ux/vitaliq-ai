{
  "name": "DailyLog",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "log_date": {
      "type": "string"
    },
    "steps": {
      "type": "number"
    },
    "water_l": {
      "type": "number"
    },
    "calories_in": {
      "type": "number"
    },
    "calories_burned": {
      "type": "number"
    },
    "sleep_hours": {
      "type": "number"
    },
    "workout_done": {
      "type": "boolean"
    },
    "diet_adherence": {
      "type": "number"
    },
    "mood": {
      "type": "string",
      "enum": [
        "great",
        "good",
        "okay",
        "tired"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "gray"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "log_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}