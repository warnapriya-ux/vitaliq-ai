{
  "name": "DietitianSubscription",
  "type": "object",
  "properties": {
    "dietitian_id": {
      "type": "string"
    },
    "dietitian_user_id": {
      "type": "string"
    },
    "dietitian_name": {
      "type": "string"
    },
    "dietitian_email": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "basic",
        "medium",
        "ultra"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink"
      ]
    },
    "cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "enumColors": [
        "blue",
        "green"
      ]
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "default": "pending"
    },
    "payment_reference": {
      "type": "string"
    },
    "started_on": {
      "type": "string"
    },
    "renews_on": {
      "type": "string"
    }
  },
  "required": [
    "plan",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.dietitian_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}