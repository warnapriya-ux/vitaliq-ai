{
  "name": "ExerciseMedia",
  "type": "object",
  "properties": {
    "exercise_id": {
      "type": "string"
    },
    "exercise_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "generated",
        "failed"
      ],
      "enumColors": [
        "green",
        "red"
      ]
    },
    "duration_sec": {
      "type": "number"
    }
  },
  "required": [
    "exercise_id",
    "video_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}